{
  "name": "quran-transcriber",
  "version": "0.1.0",
  "description": "Follow along with Quran recitations via real-time Arabic speech recognition",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
