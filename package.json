    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/dom-speech-recognition": "^0.0.12",
    "typescript": "^7.0.0",
    "wxt": "^0.21.4"
  }
}
