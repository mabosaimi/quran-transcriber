{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "entrypoints/**",
      "lib/**",
      "*.ts",
      "!!**/.output",
      "!!**/.wxt",
      "!!**/node_modules"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noHexColors": "off"
      }
    }
  },
  "javascript": {
    "globals": [
      "browser",
      "storage",
      "defineBackground",
      "defineContentScript",
      "defineUnlistedScript",
      "SpeechRecognition",
      "webkitSpeechRecognition"
    ],
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}